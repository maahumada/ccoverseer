{
  "statusLine": {
    "type": "command",
    "command": "~/.local/share/ccoverseer/core/usage-tap.sh"
  },
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "~/.local/share/ccoverseer/core/hooks/state.sh working", "async": true } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "~/.local/share/ccoverseer/core/hooks/state.sh working", "async": true } ] }
    ],
    "Notification": [
      { "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [ { "type": "command", "command": "~/.local/share/ccoverseer/core/hooks/state.sh blocked", "async": true } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "~/.local/share/ccoverseer/core/hooks/state.sh done", "async": true } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "~/.local/share/ccoverseer/core/hooks/state.sh end", "async": true } ] }
    ]
  }
}
